{
  "name": "@vinena/vectoys-cli",
  "version": "0.2.1",
  "description": "Copy vectoys devices and toys into your project.",
  "license": "MIT",
  "homepage": "https://github.com/vinenastudio/vectoys#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinenastudio/vectoys.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/vinenastudio/vectoys/issues"
  },
  "type": "module",
  "bin": {
    "vectoys": "./dist/index.js"
  },
  "files": ["dist", "SKILL.md"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun build src/index.ts --target node --outfile dist/index.js",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@vectoys/registry-build": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
