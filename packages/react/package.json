{
  "name": "@vinena/vectoys-react",
  "version": "0.2.1",
  "description": "React pieces for vectoys scenes: a stage that scales with its parent, drawn faces and live screens.",
  "license": "MIT",
  "homepage": "https://github.com/vinenastudio/vectoys#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinenastudio/vectoys.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/vinenastudio/vectoys/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run --cwd ../engine build && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@vinena/vectoys": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
